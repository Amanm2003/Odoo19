<odoo>

    <!-- Tree View -->
    <record id="approval_config_tree" model="ir.ui.view">
        <field name="name">sale.approval.config.tree</field>
        <field name="model">sale.approval.config</field>
        <field name="arch" type="xml">
            <list string="Approval Configurations">
                <field name="name"/>
                <field name="min_amount"/>
                <field name="max_amount"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="approval_config_form" model="ir.ui.view">
        <field name="name">sale.approval.config.form</field>
        <field name="model">sale.approval.config</field>
        <field name="arch" type="xml">
            <form string="Approval Configuration">

                <sheet>

                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Approval Level"/>
                        </h1>
                    </div>

                    <!-- Main Information -->
                    <group>
                        <group string="Approval Details">

                            <field name="min_amount"/>
                            <field name="max_amount"/>
                            <field name="credit_limit_breach"/>

                        </group>

                        <!-- <group string="Summary">

                            <label string="This approval rule will be applied to Sale Orders whose total falls within the configured amount range."/>

                        </group> -->
                    </group>

                    <!-- Notebook -->
                    <notebook>

                        <page string="Approvers">
                            <field name="approver_ids"
                                   widget="many2many_tags"
                                   options="{'no_create_edit': False}"/>
                        </page>

                    </notebook>

                </sheet>

                <!-- Chatter -->
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>

            </form>
        </field>
    </record>

</odoo>