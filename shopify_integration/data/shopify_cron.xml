<odoo>
    <record id="ir_cron_shopify_sync" model="ir.cron">
        <field name="name">Shopify Product Sync</field>
        <field name="model_id" ref="model_shopify_integration"/>
        <field name="state">code</field>
        <field name="code">model.fetch_products()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <!-- <field name="numbercall">-1</field> -->
        <field name="active">False</field>
    </record>
    <record id="ir_cron_shopify_sync_customer" model="ir.cron">
        <field name="name">Shopify Customer Sync</field>
        <field name="model_id" ref="model_shopify_integration"/>
        <field name="state">code</field>
        <field name="code">model.fetch_customers()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <!-- <field name="numbercall">-1</field> -->
        <field name="active">False</field>
    </record>
    <record id="ir_cron_shopify_sync_order" model="ir.cron">
        <field name="name">Shopify Order Sync</field>
        <field name="model_id" ref="model_shopify_integration"/>
        <field name="state">code</field>
        <field name="code">model.fetch_orders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <!-- <field name="numbercall">-1</field> -->
        <field name="active">True</field>
    </record>
</odoo>
