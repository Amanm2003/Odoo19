<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_credit_control" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.credit.control</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Credit Control" name="credit_control_setting_container"
                       id="credit_control_block">
                    <setting string="Credit Approvers"
                             help="Users allowed to approve or refuse sale orders placed on credit hold. Any one of them approving is sufficient to release an order.">
                        <field name="credit_approver_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
